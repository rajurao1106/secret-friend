{
  "name": "secret-friend-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.2",
    "fastify-plugin": "^6.0.1",
    "firebase-admin": "^14.5.0",
    "geo-tz": "^8.1.9",
    "pg": "^8.16.3",
    "socket.io": "^4.8.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.25.4",
    "jwks-rsa": "^3.2.0"
  }
}